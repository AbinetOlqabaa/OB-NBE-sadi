{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "serve": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/run-all-tests.ts",
    "simulator": "python3 nbe_simulator_service/manage.py runserver 0.0.0.0:8001",
    "test:simulator": "PYTHONPATH=nbe_simulator_service python3 nbe_simulator_service/manage.py test apps.simulator.tests",
    "test:backend": "PYTHONPATH=backend python3 backend/manage.py test apps.accounts apps.audit apps.permissions apps.nbe_gateway apps.workflows",
    "test:all": "npm test && npm run test:simulator && npm run test:backend"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
